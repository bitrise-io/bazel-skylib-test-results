# Heavy test scenarios for load-testing test results capture, one test_suite per Bitrise workflow
# (see run.sh). The targets are generated by heavy.bzl and are all "manual", so `bazel test //...`
# never runs them.
load(":heavy.bzl", "heavy_deep", "heavy_noisy", "heavy_wide")

# Large monorepo, many small targets. test_over_limit runs the same suite with --runs_per_test=6,
# which makes more than 20,000 test results in one invocation.
heavy_wide(
    name = "wide",
    count = 4000,
)

# A few targets with very many cases, about 102,500 in all: over the 5,000 cases kept per file
# (6k and 12k), over the 16 MiB copied per file (huge_xml) and over 100,000 per invocation.
heavy_deep(
    name = "deep",
    targets = {
        "4k": {"cases": 4000, "fail_every": 50, "out": 512, "fail_out": 40960, "stack": 40},
        "6k_a": {"cases": 6000, "fail_every": 33, "out": 256, "fail_out": 4096, "stack": 30},
        "6k_b": {"cases": 6000, "fail_every": 33, "out": 256, "fail_out": 4096, "stack": 30},
        "12k": {"cases": 12000, "fail_every": 20, "out": 64, "fail_out": 8192, "stack": 60},
        "sharded": {"cases": 12000, "fail_every": 50, "out": 128, "fail_out": 2048, "stack": 20, "shards": 4},
        "huge_xml": {"cases": 2500, "fail_every": 50, "out": 8192, "fail_out": 8192, "stack": 20},
        "10k_1": {"cases": 10000, "fail_every": 100, "out": 512, "fail_out": 2048, "stack": 20},
        "10k_2": {"cases": 10000, "fail_every": 100, "out": 512, "fail_out": 2048, "stack": 20},
        "10k_3": {"cases": 10000, "fail_every": 100, "out": 512, "fail_out": 2048, "stack": 20},
        "10k_4": {"cases": 10000, "fail_every": 100, "out": 512, "fail_out": 2048, "stack": 20},
        "10k_5": {"cases": 10000, "fail_every": 100, "out": 512, "fail_out": 2048, "stack": 20},
        "10k_6": {"cases": 10000, "fail_every": 100, "out": 512, "fail_out": 2048, "stack": 20},
    },
)

# Retries, sharding, timeouts, 12-40 MiB logs, warnings over the text budget, many and long tags,
# control characters and malformed XML, and fake credentials that must come out redacted.
heavy_noisy(
    name = "noisy",
    failing = 20,
    flaky = 60,
    passing = 100,
    shards = 10,
)
